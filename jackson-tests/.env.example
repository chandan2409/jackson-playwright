# Firelight FLQANEXT sandbox (Hexure) — Day 0 credentials from Jackson
FIRELIGHT_BASE_URL=https://flqanext.insurancetechnologies.com/EGApp/
FIRELIGHT_USERNAME=
FIRELIGHT_PASSWORD=

# POC case selection
FIRELIGHT_JURISDICTION=Colorado
FIRELIGHT_PRODUCT=Elite Access II
FIRELIGHT_CASE_NAME=Boun

# Optional: path to announced change tickets JSON for Day 8 classification
CHANGE_TICKETS_PATH=tests/data/change-tickets.json

# Optional: Jira Cloud for /file-jira (Cursor MCP) and Change review File to Jira (REST).
# Markdown defects stay source of truth. Do not commit tokens.
# File to Jira attaches tests/reports/changes/evidence/<page>.png when Detect (live) produced one.
JIRA_PROJECT_KEY=
JIRA_CLOUD_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: set to 1 if Node TLS fails with UNABLE_TO_GET_ISSUER_CERT_LOCALLY (corp proxy)
JIRA_TLS_INSECURE=1

# Keep Playwright failure screenshots/videos under test-results/runs/<timestamp>/.
# Each run uses a new folder so a later pass does not wipe an earlier fail.
# Blob reports (for merged HTML history) live under blob-report/runs/<timestamp>/.
# npm run artifacts:prune (also runs before test:script1/2) deletes run folders older than this many days.
# After each Script 1/2 run, blobs are merged into playwright-report-all (or npm run report:all).
ARTIFACT_RETENTION_DAYS=14
