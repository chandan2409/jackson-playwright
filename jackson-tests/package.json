{
  "name": "jackson-tests",
  "version": "1.0.0",
  "description": "Jackson Firelight POC — Playwright scripts, baselines, and change reports",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:script1": "playwright test tests/specs/script-1-happy-path.spec.ts",
    "test:script2": "playwright test tests/specs/script-2-variant-path.spec.ts",
    "baseline:capture": "tsx tests/utils/baseline-capture.ts",
    "detect:changes": "tsx tests/utils/change-detector.ts",
    "heal:accept": "tsx tests/utils/apply-heal-acceptance.ts",
    "report:schema": "node -e \"console.log(require('fs').readFileSync('tests/reports/changes/change-report.schema.json','utf8'))\"",
    "auth:setup": "playwright test --project=setup",
    "headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
